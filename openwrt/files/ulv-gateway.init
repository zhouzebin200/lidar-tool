#!/bin/sh /etc/rc.common

START=95
STOP=10
USE_PROCD=1

start_service() {
    local enabled host port
    config_load ulv-gateway
    config_get_bool enabled main enabled 1
    [ "$enabled" -eq 1 ] || return 0
    config_get host main host "0.0.0.0"
    config_get port main port "17777"

    procd_open_instance
    procd_set_param command /usr/bin/python3 /usr/lib/ulv-gateway/run.py \
        --host "$host" --port "$port" --no-browser --service-mode --gateway-only
    procd_set_param env PYTHONPATH=/usr/lib/ulv-gateway XDG_CONFIG_HOME=/etc/ulv-gateway
    procd_set_param respawn 3600 5 5
    procd_set_param limits nofile="65535 65535"
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

service_triggers() {
    procd_add_reload_trigger "ulv-gateway"
}
