-template <typename T_PointCloud>
-inline void DecoderRSEM4<T_PointCloud>::rleDecodeMethod(uint8_t* udp_payload, const uint16_t payload_len, uint16_t* radius_decode_array, uint16_t *ref_attr_decode_array, bool is_wreck,
-                                           const int16_t yaw_angle, const double pkt_ts)
-{                                           
-  
-  uint32_t parse_index = sizeof(RSEM4MsopHeader);
-  if((parse_index + 3 ) >= payload_len ){
-    return ;
-  }
-
-    //distance
-  uint32_t radius_decode_len = 0;
-  uint16_t radius_raw_len = 0;
-
-  if ((udp_payload[parse_index] != 0x55) || (udp_payload[parse_index + 1] != 0xaa))
-  {
-    return ;
-  }
-  radius_raw_len = (uint16_t)((udp_payload[parse_index + 2] << 8) | udp_payload[parse_index + 3]);
-  bool radius_rle_ret = this->rle_->PcC_u32OffsetRLEDecode(udp_payload + 36, radius_raw_len, radius_decode_array, EM4_PIXELS_PER_COLUMN, radius_decode_len);
-    /* Prevent the compiler warning about the unused parameter. */
-  (void)radius_rle_ret;
-
-      //intensity
-  uint32_t intensity_decode_len = 0;
-  uint16_t intensity_raw_len = 0;
-
-  // update parse index 
-  parse_index = parse_index + 4 + radius_raw_len;
-  if((parse_index + 4 ) >= payload_len ){
-    return ;
-  }
-  if ((udp_payload[parse_index] != 0xaa) || (udp_payload[parse_index + 1] != 0x55))
-  {
-    return ;
-  }
-
-  intensity_raw_len = (uint16_t)((udp_payload[parse_index + 2] << 8) | udp_payload[parse_index + 3]);
-  bool intensity_rle_ret = this->rle_->PcC_u32OffsetRLEDecode(udp_payload + parse_index + 4, intensity_raw_len, ref_attr_decode_array, EM4_PIXELS_PER_COLUMN, intensity_decode_len);   
-
-  int actual_decode_len = EM4_PIXELS_PER_COLUMN;
-  if ((intensity_rle_ret || is_wreck) && intensity_decode_len < EM4_PIXELS_PER_COLUMN && intensity_decode_len > 0) {
-    actual_decode_len = intensity_decode_len;
-  }
-  for (int i = 0; i < actual_decode_len; i++)
-  {
-    int real_chan = i;
-    float distance = radius_decode_array[i] * this->const_param_.DISTANCE_RES;
-    uint8_t point_attribute =  (uint8_t)((ref_attr_decode_array[i] >> 8) & 0xFFU);
-    uint8_t feature = point_attribute >> 7;
-    if (this->distance_section_.in(distance))
-    {     
-      int vecsel = real_chan / EM4_PIXELS_PER_VCSEL;
-      int yaw = yaw_angle + this->yaw_offset_[vecsel];
-      int pitch = this->pitch_angle_[real_chan];
-      float x = distance * COS (pitch) * COS (yaw);
-      float y = distance * COS (pitch) * SIN (yaw);
-      float z = distance * SIN (pitch);
-      this->transformPoint(x, y, z);      
-      uint8_t intensity = (uint8_t)(ref_attr_decode_array[i] & 0xFFU);
-
-      typename T_PointCloud::PointT point;
-
-      setX(point, x);
-      setY(point, y);
-      setZ(point, z);      
-      setTimestamp(point, pkt_ts);
-      setRing(point, real_chan);
-      setIntensity(point,intensity);
-      setFeature(point, feature);
-      this->point_cloud_->points.emplace_back(point);
-    }
-    else if (!this->param_.dense_points)
-    {
-      typename T_PointCloud::PointT point;
-      setX(point, NAN);
-      setY(point, NAN);
-      setZ(point, NAN);
-      setIntensity(point, 0);
-      setTimestamp(point, pkt_ts);
-      setRing(point, real_chan);
-      setFeature(point, feature);
-      this->point_cloud_->points.emplace_back(point);
-    }
-    this->prev_point_ts_ = pkt_ts;
-  }
-  this->prev_pkt_ts_ = pkt_ts;
-}
