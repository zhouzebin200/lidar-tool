-template <typename T_PointCloud>
-
-inline bool DecoderRSEM4<T_PointCloud>::decodeCompPkt(const uint8_t* packet, size_t size)
-{
-  if(size < sizeof(RSEM4MsopHeader))
-  {
-    return false;
-  }
-  bool ret = false;
-  const RSEM4MsopHeader& header = *(RSEM4MsopHeader*)packet;
-  
-  double pkt_ts = 0;
-  if (this->param_.use_lidar_clock)
-  {
-    pkt_ts = parseTimeUTCWithUs(&header.timestamp) * 1e-6;
-  }
-  else
-  {
-    uint64_t ts = getTimeHost();
-
-    // roll back to first block to approach lidar ts as near as possible.
-    pkt_ts = getTimeHost() * 1e-6 - this->getPacketDuration();
-
-    if (this->write_pkt_ts_)
-    {
-      createTimeUTCWithUs (ts, (RSTimestampUTC*)&header.timestamp);
-    }
-  }
-  uint16_t pkt_seq = ntohs(header.pkt_seq);
-  uint8_t split_pack_num = header.pack_mode >> 4;
-  this->temperature_ = static_cast<float>((int)header.temperature - this->const_param_.TEMPERATURE_RES);
- 
-  
-  if (split_pack_num != 0x2 && split_strategy_.newPacket(pkt_seq))
-  {
-    // msop-compress-debug
-    this->cb_split_frame_(this->const_param_.LASER_NUM, this->cloudTs());
-    this->first_point_ts_ = pkt_ts;
-    ret = true;
-  }
-  
-  int16_t yaw_angle = ntohs(header.yaw_angle);
-
-
-    /* split_pack_num: 0: no split, 1: 1st pack, 2: 2nd pack
-    ALL CASES: 
-    * ABC-    00 01 02
-    * DEF1F2- 10 11 12
-    * G123-   20 21 22
-    
-    1 case A:
-      prev: 0
-      post: 0
-      - proc: normal parse current 
-    2 case B:
-      prev: 0
-      post: 1
-      - proc: normal save current 
-    3 case C:
-      prev: 0
-      post: 2
-      - proc: drop current 
-    4 case D:
-      prev: 1
-      post: 0
-      - proc: parse previous  and current 
-    5 case E:
-      prev: 1
-      post: 1
-      - proc: parse it forcely and refresh buffer - parse method: parse 1 & save 1
-    case F:
-      prev: 1
-      post: 2
-      6 case F1: pkt_cnt prev == post
-      - proc: parse it as split-packs - parse method combine and parse
-      7 case F2: pkt_cnt prev != post
-      - proc: parse it forcely and drop current - parse method: parse 1 & drop 1
-    case G:
-      8 case G1:
-        prev: 2
-        post: 0
-        - proc: normal parse
-      9 case G2:
-        prev: 2
-        post: 1
-        - proc: normal save
-      10 case G3:
-        prev: 2
-        post: 2
-        - drop current 
-  
-  */
-
-  if ((this->pre_pkt_info_.type == 0) && (split_pack_num == 0x2)) //case C
-  {
-    return false;
-  }
-
-  if ((this->pre_pkt_info_.type == 2) && (split_pack_num == 0x2)) // case G3
-  {
-    return false;
-  }
-
-  //distance
-  uint16_t radius_decode_array[EM4_PIXELS_PER_COLUMN] = { 0 };
-
-  //intensity
-  uint16_t ref_attr_decode_array[EM4_PIXELS_PER_COLUMN] = { 0 };
-  uint8_t* udp_payload_input = (uint8_t *)packet;
-  if (this->pre_pkt_info_.type == 1)
-  {
-    if (split_pack_num == 0x0) //case D
-    {
-      parsePrePkt(radius_decode_array, ref_attr_decode_array);
-      parseCurPkt(udp_payload_input, size, radius_decode_array, ref_attr_decode_array, 
-                            yaw_angle, pkt_ts);
-    }else if (split_pack_num == 0x1) //case E
-    {
-      parsePrePkt(radius_decode_array, ref_attr_decode_array);
-      saveCurPkt(udp_payload_input, size, yaw_angle, pkt_ts);
-    }else if (split_pack_num == 0x2) // case F
-    {
-      if(this->pre_pkt_info_.length != EM4_COMPRESS_SPLIT_LEN || this->pre_pkt_info_.seq != pkt_seq) //case F2
-      {
-        parsePrePkt(radius_decode_array, ref_attr_decode_array);
-      }else{
-        parseCompDataCombine(udp_payload_input, size, radius_decode_array, ref_attr_decode_array, 
-                        yaw_angle, pkt_ts); //case F1
-      }
-    }
-  }
-  else if(split_pack_num == 0x1)   // case B (01) & case G2 (21)
-  {
-    saveCurPkt(udp_payload_input, size, yaw_angle, pkt_ts);
-  }
-  else   // case A (00) & case G1 (20)
-  {
-    parseCurPkt(udp_payload_input, size, radius_decode_array, ref_attr_decode_array, 
-                            yaw_angle, pkt_ts);
-  }
-  this->pre_pkt_info_.type = split_pack_num;
-  this->pre_pkt_info_.seq = pkt_seq;
-  
-  return ret;
-}
